{
  "name": "com.andreszs.cgs.demo",
  "displayName": "Google Code Scanner Demo",
  "version": "1.0.0",
  "description": "Cordova Android demo for cordova-plugin-google-code-scanner.",
  "scripts": {
    "build:android": "cordova build android --debug",
    "run:android": "cordova run android --device --debug"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "cordova-android": "15.0.0",
    "cordova-plugin-app-version": "0.1.14",
    "cordova-plugin-google-code-scanner": "1.1.0",
    "cordova-plugin-inappbrowser": "7.0.0"
  },
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-app-version": {},
      "cordova-plugin-google-code-scanner": {
        "PLAY_SERVICES_GCS_VERSION": "16.1.0"
      },
      "cordova-plugin-inappbrowser": {}
    }
  }
}
