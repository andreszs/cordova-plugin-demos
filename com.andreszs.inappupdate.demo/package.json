{
  "name": "com.andreszs.inappupdate.demo",
  "displayName": "In-App Update Demo",
  "version": "1.3.5",
  "description": "Cordova Android demo for cordova-plugin-in-app-updates.",
  "scripts": {
    "build:android": "cordova build android --debug",
    "run:android": "cordova run android --device --debug"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "cordova-android": "15.0.0",
    "cordova-plugin-app-version": "0.1.14",
    "cordova-plugin-in-app-updates": "2.3.0",
    "cordova-plugin-inappbrowser": "7.0.0"
  },
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-app-version": {},
      "cordova-plugin-in-app-updates": {
        "ANDROID_PLAY_APP_UPDATE_VERSION": "2.1.0"
      },
      "cordova-plugin-inappbrowser": {}
    }
  }
}