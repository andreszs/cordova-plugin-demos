{
  "name": "com.andreszs.mlkit.suite.demo",
  "displayName": "ML Kit Suite Demo",
  "version": "1.9.12",
  "description": "Cordova Android demo for cordova-plugin-mlkit-suite.",
  "main": "index.js",
  "scripts": {
    "build:android": "cordova build android --debug",
    "run:android": "cordova run android --device --debug"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Andreszs",
  "license": "Apache-2.0",
  "devDependencies": {
    "cordova-android": "15.1.0",
    "cordova-plugin-camera": "6.0.0",
    "cordova-plugin-mlkit-suite": "0.2.2",
    "cordova-plugin-native-spinner": "1.1.4"
  },
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-camera": {},
      "cordova-plugin-native-spinner": {},
      "cordova-plugin-file": {
        "ANDROIDX_WEBKIT_VERSION": "1.4.0"
      },
      "cordova-plugin-mlkit-suite": {
        "ANDROID_MLKIT_MODEL_DELIVERY": "first-use",
        "ANDROID_MLKIT_FACE_MODE": "first-use",
        "ANDROID_MLKIT_BARCODE_MODE": "first-use",
        "ANDROID_MLKIT_IMAGE_LABELING_MODE": "first-use",
        "ANDROID_MLKIT_OCR_MODE": "first-use",
        "ANDROID_MLKIT_SUBJECT_SEGMENTATION_MODE": "first-use"
      }
    }
  },
  "dependencies": {
    "cordova-plugin-file": "7.0.0"
  }
}
